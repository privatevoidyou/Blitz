import { CheckBox, LineEdit, Button, Switch, ListView } from "std-widgets.slint";

export struct Proc { label: string, icon: image, checked: bool, header: bool, hint: string }
export struct App { name: string, icon: image, added: bool }

// One full-width CheckBox owns every left click in this row. Decorative
// image/text siblings have no input handlers; ContextMenuArea handles right click.
export component ProcessEntry inherits ContextMenuArea {
    in property <Proc> item;
    callback toggled(bool);
    callback whitelist();
    height: root.item.hint == "" ? 30px : 44px;
    enabled: !root.item.header;
    if !root.item.header: CheckBox {
        x: 2px; width: parent.width - 2px; height: parent.height;
        text: ""; accessible-label: root.item.label + " " + root.item.hint;
        checked: root.item.checked;
        toggled => { root.toggled(self.checked); }
    }
    HorizontalLayout {
        padding-left: root.item.header ? 2px : 36px; spacing: 6px;
        if !root.item.header: VerticalLayout {
            alignment: center;
            Image { source: root.item.icon; width: 16px; height: 16px; }
        }
        VerticalLayout {
            alignment: center; spacing: 0px;
            Text {
                text: root.item.label; vertical-alignment: center;
                overflow: elide; horizontal-stretch: 1;
                color: root.item.header ? #ffffff90 : white;
                font-weight: root.item.header ? 600 : 400;
            }
            if root.item.hint != "": Text {
                text: root.item.hint; font-size: 10px; color: #f5b942; overflow: elide;
            }
        }
    }
    Menu {
        MenuItem {
            title: "加入白名单（永不显示）";
            enabled: !root.item.header;
            activated => { root.whitelist(); }
        }
    }
}

export component AppTile inherits ContextMenuArea {
    in property <App> item;
    callback launch();
    callback remove();
    Rectangle {
        border-radius: 8px;
        background: tile-touch.has-hover ? #ffffff14 : transparent;
        VerticalLayout {
            padding: 4px; spacing: 4px; alignment: center;
            HorizontalLayout { alignment: center; Image { source: root.item.icon; width: 36px; height: 36px; } }
            Text { text: root.item.name; color: #ffffffe0; font-size: 11px; horizontal-alignment: center; overflow: elide; wrap: no-wrap; }
        }
        tile-touch := TouchArea {
            clicked => { root.launch(); }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                    root.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    Menu { MenuItem { title: "移除此快捷方式"; activated => { root.remove(); } } }
}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <length> glyph-size: 16px;
    callback clicked();
    border-radius: 6px;
    background: ta.has-hover ? #ffffff18 : transparent;
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 4px;
        alignment: center;
        Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: root.glyph-size; color: white; vertical-alignment: center; }
        if root.label != "": Text { text: root.label; color: #ffffffe0; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component Panel inherits Window {
    title: "疾风加速";
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 480px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: #1b1d22;

    // 0 = shortcuts, 1 = processes, 2 = settings, 3 = add shortcuts
    in-out property <int> view: 0;
    in property <[App]> apps;
    in property <[App]> installed;
    in property <int> page;
    in property <int> pages: 1;
    in property <[Proc]> items;
    in property <float> mem-pct;
    in property <string> status;
    in property <bool> show-admin;
    in property <bool> busy;
    in property <bool> shutdown-armed;
    in-out property <bool> trim;
    in-out property <bool> auto-start;
    in-out property <bool> auto-boost;
    in-out property <bool> trim-default;
    in-out property <string> app-query;
    in-out property <string> proc-query;
    in-out property <string> installed-query;

    callback launch(int);
    callback remove-shortcut(int);
    callback show-add();
    callback add-installed(int);
    callback browse-shortcut();
    callback installed-search(string);
    callback set-page(int);
    callback app-search(string);
    callback proc-search(string);
    callback toggled(int, bool);
    callback whitelist(int);
    callback boost();
    callback trim-changed(bool);
    callback auto-start-changed(bool);
    callback auto-boost-changed(bool);
    callback trim-default-changed(bool);
    callback restart-admin();
    callback shutdown();
    callback my-computer();
    callback screenshot();
    callback show-procs();

    Rectangle { border-width: 1px; border-color: #ffffff22; }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // header
        HorizontalLayout {
            spacing: 6px;
            height: 34px;
            if root.view != 0: IconBtn { glyph: "\u{E72B}"; width: 34px; clicked => { root.view = 0; } }
            if root.view == 0: LineEdit {
                placeholder-text: "搜索我的快捷方式";
                text <=> root.app-query;
                edited(t) => { root.app-search(t); }
            }
            if root.view == 1: LineEdit {
                placeholder-text: "搜索进程";
                text <=> root.proc-query;
                edited(t) => { root.proc-search(t); }
            }
            if root.view == 3: LineEdit {
                placeholder-text: "搜索已安装的软件";
                text <=> root.installed-query;
                edited(t) => { root.installed-search(t); }
            }
            if root.view == 0: IconBtn { glyph: "\u{E710}"; label: "添加"; clicked => { root.show-add(); } }
            if root.view == 2: Text { text: "设置"; font-size: 16px; font-weight: 600; color: white; vertical-alignment: center; horizontal-stretch: 1; }
            if root.view != 2: IconBtn { glyph: "\u{E713}"; width: 34px; clicked => { root.view = 2; } }
        }

        // body
        Rectangle {
            vertical-stretch: 1;

            // launcher grid 4x3
            if root.view == 0: Rectangle {
                property <length> cw: self.width / 4;
                property <length> ch: (self.height - 24px) / 3;
                for a[i] in root.apps: AppTile {
                    x: mod(i, 4) * cw; y: floor(i / 4) * ch;
                    width: cw; height: ch;
                    item: a;
                    launch => { root.launch(i); }
                    remove => { root.remove-shortcut(i); }
                }
                if root.apps.length == 0: VerticalLayout {
                    alignment: center; spacing: 10px;
                    Text { text: root.app-query == "" ? "还没有快捷方式" : "没有匹配的快捷方式"; color: #ffffffa0; horizontal-alignment: center; }
                    Button { text: "添加快捷方式"; clicked => { root.show-add(); } }
                }
                if root.pages > 1: HorizontalLayout {
                    y: parent.height - 24px; height: 24px;
                    alignment: center; spacing: 12px;
                    IconBtn { glyph: "\u{E76B}"; width: 28px; clicked => { if (root.page > 0) { root.set-page(root.page - 1); } } }
                    Text { text: (root.page + 1) + " / " + root.pages; color: white; vertical-alignment: center; }
                    IconBtn { glyph: "\u{E76C}"; width: 28px; clicked => { if (root.page + 1 < root.pages) { root.set-page(root.page + 1); } } }
                }
            }

            if root.view == 3: VerticalLayout {
                spacing: 8px;
                Text { text: "从开始菜单和桌面选择，添加后显示在首页"; color: #ffffff90; font-size: 11px; wrap: word-wrap; }
                ListView {
                    vertical-stretch: 1;
                    for a[i] in root.installed: Rectangle {
                        height: 38px;
                        background: candidate-touch.has-hover ? #ffffff14 : transparent;
                        HorizontalLayout {
                            spacing: 8px; padding-left: 4px; padding-right: 6px;
                            VerticalLayout { alignment: center; Image { source: a.icon; width: 24px; height: 24px; } }
                            Text { text: a.name; color: white; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: a.added ? "已添加" : "添加"; color: a.added ? #ffffff60 : #9fd0ff; vertical-alignment: center; }
                        }
                        candidate-touch := TouchArea { enabled: !a.added; clicked => { root.add-installed(i); } }
                    }
                }
                Button { text: "选择 .lnk / .exe 文件…"; clicked => { root.browse-shortcut(); } }
            }

            // process selection
            if root.view == 1: VerticalLayout {
                spacing: 6px;
                CheckBox { text: "整理内存（仅本工具及所选程序）"; checked <=> root.trim; toggled => { root.trim-changed(self.checked); } }
                Text { text: "点击整行勾选 · 右键白名单 · 后台依赖无法完整识别"; color: #ffffff90; font-size: 11px; }
                ListView {
                    vertical-stretch: 1;
                    for p[i] in root.items: ProcessEntry {
                        item: p;
                        toggled(on) => { root.toggled(i, on); }
                        whitelist => { root.whitelist(i); }
                    }
                }
                if root.show-admin: Button { text: "以管理员重启"; clicked => { root.restart-admin(); } }
            }

            // settings
            if root.view == 2: VerticalLayout {
                spacing: 14px;
                alignment: start;
                HorizontalLayout { Text { text: "开机自动启动"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.auto-start; toggled => { root.auto-start-changed(self.checked); } } }
                HorizontalLayout { Text { text: "启动后自动加速"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.auto-boost; toggled => { root.auto-boost-changed(self.checked); } } }
                HorizontalLayout { Text { text: "默认整理所选程序内存"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.trim-default; toggled => { root.trim-default-changed(self.checked); } } }
                Button { text: "选择要关闭的软件…"; clicked => { root.show-procs(); } }
                Text { text: "Blitz 疾风加速 · 托盘左键打开面板，右键菜单可退出"; color: #ffffff70; font-size: 11px; wrap: word-wrap; }
            }
        }

        if root.status != "": Text { text: root.status; font-size: 12px; color: #9fd0ff; wrap: word-wrap; }

        // bottom bar
        Rectangle { height: 1px; background: #ffffff18; }
        HorizontalLayout {
            height: 36px;
            spacing: 2px;
            IconBtn { glyph: "\u{E7E8}"; label: root.shutdown-armed ? "确认?" : "关机"; clicked => { root.shutdown(); } }
            IconBtn { glyph: "\u{E7F4}"; label: "我的电脑"; clicked => { root.my-computer(); } }
            IconBtn { glyph: "\u{E924}"; label: "截图"; clicked => { root.screenshot(); } }
        }
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: mt.has-hover ? #ffffff14 : transparent;
                VerticalLayout {
                    alignment: center; spacing: 4px; padding-left: 4px; padding-right: 4px;
                    HorizontalLayout {
                        Text { text: "资源占用:" + round(root.mem-pct * 100) + "%"; color: white; font-size: 12px; horizontal-stretch: 1; }
                        Text { text: root.view == 1 ? "\u{E70E}" : "\u{E70D}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: #ffffffb0; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 5px; border-radius: 2.5px; background: #ffffff20;
                        Rectangle {
                            x: 0; width: parent.width * root.mem-pct; border-radius: 2.5px;
                            background: root.mem-pct > 0.8 ? #ff6b5b : (root.mem-pct > 0.6 ? #f5b942 : #4cc38a);
                        }
                    }
                }
                mt := TouchArea { clicked => { if (root.view == 1) { root.view = 0; } else { root.show-procs(); } } }
            }
            Rectangle {
                width: 110px;
                border-radius: 6px;
                background: root.busy ? #3d8bfd80 : (bt.pressed ? #2f6fd0 : (bt.has-hover ? #4a96ff : #3d8bfd));
                Text { text: root.busy ? "加速中…" : "一键疾风"; color: white; font-size: 14px; font-weight: 600; }
                bt := TouchArea { enabled: !root.busy; clicked => { root.boost(); } }
            }
        }
    }

}
