import { CheckBox, LineEdit, Button, Switch, ListView } from "std-widgets.slint";

export struct Proc { label: string, icon: image, checked: bool, header: bool }
export struct App { name: string, icon: image }

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <length> glyph-size: 16px;
    callback clicked();
    border-radius: 6px;
    background: ta.has-hover ? #ffffff18 : transparent;
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 4px;
        alignment: center;
        Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: root.glyph-size; color: white; vertical-alignment: center; }
        if root.label != "": Text { text: root.label; color: #ffffffe0; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component Panel inherits Window {
    title: "疾风加速";
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 480px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: #1b1d22f0;

    // 0 = launcher, 1 = processes, 2 = settings
    in-out property <int> view: 0;
    in property <[App]> apps;
    in property <int> page;
    in property <int> pages: 1;
    in property <[Proc]> items;
    in property <float> mem-pct;
    in property <string> status;
    in property <bool> show-admin;
    in property <bool> busy;
    in property <bool> shutdown-armed;
    in-out property <bool> trim;
    in-out property <bool> auto-start;
    in-out property <bool> auto-boost;
    in-out property <bool> trim-default;
    in-out property <string> app-query;
    in-out property <string> proc-query;

    callback launch(int);
    callback set-page(int);
    callback app-search(string);
    callback proc-search(string);
    callback toggled(int, bool);
    callback whitelist(int);
    callback boost();
    callback trim-changed(bool);
    callback auto-start-changed(bool);
    callback auto-boost-changed(bool);
    callback trim-default-changed(bool);
    callback restart-admin();
    callback shutdown();
    callback my-computer();
    callback screenshot();
    callback show-procs();

    property <int> menu-index: -1;

    Rectangle { border-width: 1px; border-color: #ffffff22; }

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // header
        HorizontalLayout {
            spacing: 6px;
            height: 34px;
            if root.view != 0: IconBtn { glyph: "\u{E72B}"; width: 34px; clicked => { root.view = 0; } }
            if root.view == 0: LineEdit {
                placeholder-text: "输入要找的软件";
                text <=> root.app-query;
                edited(t) => { root.app-search(t); }
            }
            if root.view == 1: LineEdit {
                placeholder-text: "搜索进程";
                text <=> root.proc-query;
                edited(t) => { root.proc-search(t); }
            }
            if root.view == 2: Text { text: "设置"; font-size: 16px; font-weight: 600; color: white; vertical-alignment: center; horizontal-stretch: 1; }
            if root.view != 2: IconBtn { glyph: "\u{E713}"; width: 34px; clicked => { root.view = 2; } }
        }

        // body
        Rectangle {
            vertical-stretch: 1;

            // launcher grid 4x3
            if root.view == 0: Rectangle {
                property <length> cw: self.width / 4;
                property <length> ch: (self.height - 24px) / 3;
                for a[i] in root.apps: Rectangle {
                    x: mod(i, 4) * cw;
                    y: floor(i / 4) * ch;
                    width: cw; height: ch;
                    border-radius: 8px;
                    background: at.has-hover ? #ffffff14 : transparent;
                    VerticalLayout {
                        padding: 4px; spacing: 4px; alignment: center;
                        HorizontalLayout { alignment: center; Image { source: a.icon; width: 36px; height: 36px; } }
                        Text { text: a.name; color: #ffffffe0; font-size: 11px; horizontal-alignment: center; overflow: elide; wrap: no-wrap; }
                    }
                    at := TouchArea { clicked => { root.launch(i); } }
                }
                if root.apps.length == 0: Text { text: "没有找到软件"; color: #ffffff80; x: (parent.width - self.width) / 2; y: 100px; }
                // pagination dots
                HorizontalLayout {
                    y: parent.height - 20px; height: 20px;
                    alignment: center; spacing: 6px;
                    for d in root.pages: Rectangle {
                        width: 22px; height: 18px; border-radius: 9px;
                        background: d == root.page ? #3d8bfd : (dt.has-hover ? #ffffff30 : #ffffff14);
                        Text { text: d + 1; font-size: 11px; color: white; }
                        dt := TouchArea { clicked => { root.set-page(d); } }
                    }
                }
                TouchArea {
                    // wheel paging without blocking clicks
                    scroll-event(e) => {
                        if (e.delta-y < 0 && root.page + 1 < root.pages) { root.set-page(root.page + 1); return accept; }
                        if (e.delta-y > 0 && root.page > 0) { root.set-page(root.page - 1); return accept; }
                        reject
                    }
                }
            }

            // process selection
            if root.view == 1: VerticalLayout {
                spacing: 6px;
                CheckBox { text: "清理系统内存"; checked <=> root.trim; toggled => { root.trim-changed(self.checked); } }
                Text { text: "勾选要关闭的软件（自动记住）· 右键加入白名单"; color: #ffffff90; font-size: 11px; }
                ListView {
                    vertical-stretch: 1;
                    for p[i] in root.items: Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            padding-left: 2px; spacing: 6px;
                            if !p.header: CheckBox { text: ""; width: 28px; checked: p.checked; toggled => { root.toggled(i, self.checked); } }
                            if !p.header: VerticalLayout { alignment: center; Image { source: p.icon; width: 16px; height: 16px; } }
                            Text {
                                text: p.label; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                color: p.header ? #ffffff90 : white; font-weight: p.header ? 600 : 400;
                            }
                        }
                        TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right && !p.header) {
                                    root.menu-index = i;
                                    menu.show();
                                }
                            }
                        }
                    }
                }
                if root.show-admin: Button { text: "以管理员重启"; clicked => { root.restart-admin(); } }
            }

            // settings
            if root.view == 2: VerticalLayout {
                spacing: 14px;
                alignment: start;
                HorizontalLayout { Text { text: "开机自动启动"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.auto-start; toggled => { root.auto-start-changed(self.checked); } } }
                HorizontalLayout { Text { text: "启动后自动加速"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.auto-boost; toggled => { root.auto-boost-changed(self.checked); } } }
                HorizontalLayout { Text { text: "默认清理系统内存"; color: white; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch { checked <=> root.trim-default; toggled => { root.trim-default-changed(self.checked); } } }
                Button { text: "选择要关闭的软件…"; clicked => { root.show-procs(); } }
                Text { text: "Blitz 疾风加速 · 托盘左键打开面板，右键菜单可退出"; color: #ffffff70; font-size: 11px; wrap: word-wrap; }
            }
        }

        if root.status != "": Text { text: root.status; font-size: 12px; color: #9fd0ff; wrap: word-wrap; }

        // bottom bar
        Rectangle { height: 1px; background: #ffffff18; }
        HorizontalLayout {
            height: 36px;
            spacing: 2px;
            IconBtn { glyph: "\u{E7E8}"; label: root.shutdown-armed ? "确认?" : "关机"; clicked => { root.shutdown(); } }
            IconBtn { glyph: "\u{E7F4}"; label: "我的电脑"; clicked => { root.my-computer(); } }
            IconBtn { glyph: "\u{E924}"; label: "截图"; clicked => { root.screenshot(); } }
        }
        HorizontalLayout {
            height: 40px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 6px;
                background: mt.has-hover ? #ffffff14 : transparent;
                VerticalLayout {
                    alignment: center; spacing: 4px; padding-left: 4px; padding-right: 4px;
                    HorizontalLayout {
                        Text { text: "资源占用:" + round(root.mem-pct * 100) + "%"; color: white; font-size: 12px; horizontal-stretch: 1; }
                        Text { text: root.view == 1 ? "\u{E70E}" : "\u{E70D}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: #ffffffb0; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 5px; border-radius: 2.5px; background: #ffffff20;
                        Rectangle {
                            x: 0; width: parent.width * root.mem-pct; border-radius: 2.5px;
                            background: root.mem-pct > 0.8 ? #ff6b5b : (root.mem-pct > 0.6 ? #f5b942 : #4cc38a);
                        }
                    }
                }
                mt := TouchArea { clicked => { if (root.view == 1) { root.view = 0; } else { root.show-procs(); } } }
            }
            Rectangle {
                width: 110px;
                border-radius: 6px;
                background: root.busy ? #3d8bfd80 : (bt.pressed ? #2f6fd0 : (bt.has-hover ? #4a96ff : #3d8bfd));
                Text { text: root.busy ? "加速中…" : "一键疾风"; color: white; font-size: 14px; font-weight: 600; }
                bt := TouchArea { enabled: !root.busy; clicked => { root.boost(); } }
            }
        }
    }

    menu := PopupWindow {
        x: 60px; y: 200px;
        Rectangle {
            background: #2c2c2c; border-radius: 6px; border-width: 1px; border-color: #ffffff30;
            width: 200px; height: 36px;
            Text { text: "加入白名单（永不显示）"; color: white; }
            TouchArea { clicked => { root.whitelist(root.menu-index); } }
        }
    }
}
