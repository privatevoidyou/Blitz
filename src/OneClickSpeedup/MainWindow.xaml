<Window x:Class="OneClickSpeedup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneClickSpeedup"
    Title="一键电脑加速">
  <Grid x:Name="Outer">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Background="Transparent" Padding="12,0,140,0">
    <TextBlock Text="一键电脑加速" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
  </Grid>
  <Grid x:Name="Root" Grid.Row="1" Padding="12,4,12,12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <TextBlock Text="一键电脑加速" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <Button x:Name="SettingsBtn" HorizontalAlignment="Right" Padding="6" ToolTipService.ToolTip="设置">
        <FontIcon Glyph="&#xE713;" FontSize="16"/>
        <Button.Flyout>
          <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="4" Width="220">
              <TextBlock Text="设置" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <ToggleSwitch x:Name="AutoStartSw" Header="开机自动启动" Toggled="Settings_Toggled"/>
              <ToggleSwitch x:Name="AutoBoostSw" Header="启动后自动加速" Toggled="Settings_Toggled"/>
              <ToggleSwitch x:Name="TrimDefaultSw" Header="默认清理系统内存" Toggled="Settings_Toggled"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
    <StackPanel Grid.Row="1">
      <TextBlock Text="加速系统性能" Opacity="0.7" FontSize="12"/>
      <CheckBox x:Name="TrimMemory" Content="清理系统内存" Checked="TrimMemory_Changed" Unchecked="TrimMemory_Changed"/>
    </StackPanel>
    <TextBlock Grid.Row="2" Text="关闭不必要运行软件" Opacity="0.7" FontSize="12"/>
    <AutoSuggestBox Grid.Row="3" x:Name="Search" PlaceholderText="搜索进程" QueryIcon="Find" TextChanged="Search_TextChanged"/>
    <ListView Grid.Row="4" x:Name="List" SelectionMode="None" IsItemClickEnabled="False">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ProcItem">
          <Grid ColumnSpacing="8" RightTapped="Item_RightTapped" Tag="{x:Bind}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Visibility="{x:Bind CheckVisibility}"/>
            <Image Grid.Column="1" Source="{x:Bind Icon}" Width="16" Height="16"/>
            <TextBlock Grid.Column="2" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontWeight="{x:Bind Weight}" Opacity="{x:Bind TextOpacity}"/>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="5" Spacing="4">
      <TextBlock x:Name="MemText" FontSize="12" Text="内存使用率"/>
      <ProgressBar x:Name="MemBar" Maximum="100"/>
      <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Opacity="0.85"/>
      <Button x:Name="AdminBtn" Content="以管理员重启" Visibility="Collapsed" Click="AdminBtn_Click"/>
    </StackPanel>
    <Button Grid.Row="6" x:Name="BoostBtn" Content="一键加速" Style="{StaticResource AccentButtonStyle}"
            HorizontalAlignment="Stretch" Height="40" Click="Boost_Click"/>
  </Grid>
  </Grid>
</Window>
